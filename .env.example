# ============================================================================
# Kolom24 (কলম২৪) - Production Environment Variables
# Ready for Vercel, Next.js App Router & Cloudflare Deployments
# ============================================================================

# --- 1. Database Connections (MongoDB / PostgreSQL / Supabase / Neon) ---
# For MongoDB Atlas:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/kolom24_news?retryWrites=true&w=majority"

# For PostgreSQL / Prisma / Supabase / Neon:
DATABASE_URL="postgresql://postgres:<password>@ep-example.ap-southeast-1.aws.neon.tech/kolom24?sslmode=require"

# --- 2. Cloudinary Media & CDN Storage (Serverless Direct Upload) ---
# Cloudinary credentials:
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_UPLOAD_PRESET="kolom24_news_prod"

# Client-accessible Cloudinary variables (Vite / Next.js):
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="kolom24_news_prod"
VITE_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="kolom24_news_prod"

# --- 3. Admin Authentication & Session Security ---
# Secret key for admin session verification and API route protection
ADMIN_SECRET_KEY="replace_with_a_secure_random_64_char_admin_secret"
ADMIN_SESSION_SECRET="replace_with_jwt_session_secret_key"

# --- 4. Application URL & Domain ---
APP_URL="https://kolom24.com"
NEXT_PUBLIC_SITE_URL="https://kolom24.com"

# --- 5. Gemini AI (Smart News Desk & SEO) ---
# Active Gemini API Key (configured)
GEMINI_API_KEY="AIzaSyA3LQ3lzRaxKrS6bQlWBUTH7vgIxyKnTlY"